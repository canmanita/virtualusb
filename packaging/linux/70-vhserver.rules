# Give the unprivileged "vhserver" service user access to USB devices (an ACL entry: other users and groups keep
# the access they already have). Needed to detach kernel drivers and forward transfers.
ACTION=="add|change", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", RUN+="/usr/bin/setfacl -m u:vhserver:rw $env{DEVNAME}"
