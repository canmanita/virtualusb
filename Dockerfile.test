# Runs the full test suite on Linux. Built multi-arch (amd64 + arm64) to exercise both before any real
# device testing; QEMU emulation under buildx/run covers arm64 on an x86_64 host.
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends libusb-1.0-0 gcc && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml requirements.txt ./
COPY vhserver ./vhserver
COPY tests ./tests
COPY docs ./docs

RUN pip install --no-cache-dir -e ".[fast,test]" cryptography

CMD ["python", "-m", "pytest", "tests/", "-v"]
